:root {
  --bg: #07111f;
  --panel: rgba(10, 24, 43, 0.86);
  --panel-2: rgba(15, 35, 60, 0.78);
  --line: rgba(102, 145, 200, 0.22);
  --text: #eef6ff;
  --muted: #9fb1ca;
  --gold: #f4c96b;
  --gold-2: #ffe2a1;
  --blue: #4aa3ff;
  --deep-blue: #081b33;
  --green: #55e6a5;
  --red: #ff6b7d;
  --shadow: rgba(0, 0, 0, 0.28);
  font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
  color: var(--text);
  background: var(--bg);
}

* {
  box-sizing: border-box;
}

body {
  margin: 0;
  min-width: 320px;
  min-height: 100vh;
  background:
    radial-gradient(circle at 15% 5%, rgba(74, 163, 255, 0.23), transparent 35%),
    radial-gradient(circle at 85% 15%, rgba(244, 201, 107, 0.18), transparent 30%),
    linear-gradient(145deg, #050a13, #071a2f 55%, #060b15);
}

button,
input,
textarea,
select {
  font: inherit;
}

button {
  border: 1px solid rgba(244, 201, 107, 0.32);
  border-radius: 999px;
  padding: 10px 14px;
  color: var(--text);
  background: rgba(255, 255, 255, 0.055);
  cursor: pointer;
  transition: transform 160ms ease, border-color 160ms ease, background 160ms ease;
}

button:hover {
  transform: translateY(-1px);
  border-color: rgba(244, 201, 107, 0.78);
  background: rgba(244, 201, 107, 0.10);
}

input,
textarea,
select {
  width: 100%;
  border: 1px solid rgba(102, 145, 200, 0.26);
  border-radius: 18px;
  padding: 12px 14px;
  color: var(--text);
  background: rgba(2, 10, 20, 0.66);
  outline: none;
}

textarea {
  min-height: 112px;
  resize: vertical;
}

select option {
  background: #07111f;
  color: var(--text);
}

.sellcoreApp {
  width: min(1480px, calc(100% - 28px));
  margin: 0 auto;
  padding: 24px 0 44px;
}

.heroPanel,
.panel,
.statsGrid article,
.coreCard,
.offerCard,
.pipelineColumn {
  border: 1px solid var(--line);
  border-radius: 28px;
  background:
    linear-gradient(145deg, rgba(255, 255, 255, 0.065), rgba(255, 255, 255, 0.025)),
    var(--panel);
  box-shadow: 0 18px 46px var(--shadow);
  backdrop-filter: blur(18px);
}

.heroPanel {
  display: flex;
  justify-content: space-between;
  gap: 20px;
  padding: clamp(22px, 4vw, 42px);
  overflow: hidden;
  position: relative;
}

.heroPanel::after {
  content: "";
  position: absolute;
  inset: auto -60px -80px auto;
  width: 280px;
  height: 280px;
  border-radius: 999px;
  background: radial-gradient(circle, rgba(244, 201, 107, 0.22), transparent 65%);
  pointer-events: none;
}

.eyebrow {
  margin: 0 0 8px;
  color: var(--gold);
  font-size: 12px;
  font-weight: 800;
  letter-spacing: 0.14em;
  text-transform: uppercase;
}

h1,
h2,
h3,
p {
  margin-top: 0;
}

h1 {
  margin-bottom: 12px;
  font-size: clamp(42px, 8vw, 88px);
  line-height: 0.92;
  letter-spacing: -0.07em;
}

h2 {
  margin-bottom: 12px;
  font-size: clamp(26px, 3vw, 42px);
  letter-spacing: -0.045em;
}

h3 {
  margin-bottom: 10px;
  font-size: 21px;
  letter-spacing: -0.025em;
}

.heroCopy {
  max-width: 760px;
  color: var(--muted);
  font-size: 18px;
  line-height: 1.6;
}

.heroBadges {
  display: flex;
  flex-wrap: wrap;
  align-content: flex-start;
  justify-content: flex-end;
  gap: 10px;
  min-width: min(420px, 100%);
}

.badge,
.statusPill {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  border: 1px solid rgba(102, 145, 200, 0.25);
  border-radius: 999px;
  padding: 7px 11px;
  color: var(--muted);
  background: rgba(255, 255, 255, 0.055);
  font-size: 12px;
  font-weight: 750;
}

.badge.gold,
.statusPill.negotiating,
.statusPill.seller-box-requested {
  border-color: rgba(244, 201, 107, 0.55);
  color: var(--gold-2);
  background: rgba(244, 201, 107, 0.10);
}

.badge.live,
.statusPill.available,
.statusPill.completed {
  border-color: rgba(85, 230, 165, 0.55);
  color: var(--green);
  background: rgba(85, 230, 165, 0.09);
}

.badge.muted,
.statusPill.archived,
.archived-pill {
  border-color: rgba(255, 107, 125, 0.44);
  color: #ffadba;
  background: rgba(255, 107, 125, 0.08);
}

.tabBar {
  display: flex;
  flex-wrap: wrap;
  gap: 10px;
  margin: 18px 0;
  padding: 8px;
  border: 1px solid var(--line);
  border-radius: 999px;
  background: rgba(3, 10, 20, 0.45);
}

.tabBar button {
  flex: 1 1 150px;
}

.tabBar button.active,
.primaryButton {
  border-color: rgba(244, 201, 107, 0.78);
  color: #08111f;
  background: linear-gradient(135deg, var(--gold), #fff1b9);
  font-weight: 900;
}

.statsGrid {
  display: grid;
  grid-template-columns: repeat(5, minmax(130px, 1fr));
  gap: 12px;
  margin-bottom: 18px;
}

.statsGrid article,
.profileGrid article {
  padding: 18px;
}

.statsGrid span,
.profileGrid span,
.detailList span,
.valueRow span,
.activityFeed span,
.pipelineColumn span {
  color: var(--muted);
  font-size: 13px;
}

.statsGrid strong,
.profileGrid strong {
  display: block;
  margin-top: 7px;
  color: var(--gold-2);
  font-size: 30px;
}

.layoutGrid {
  display: grid;
  grid-template-columns: minmax(0, 1.7fr) minmax(330px, 0.8fr);
  gap: 18px;
}

.panel {
  padding: clamp(18px, 3vw, 28px);
}

.sectionHeader {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 14px;
  margin-bottom: 18px;
}

.cardGrid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(270px, 1fr));
  gap: 14px;
}

.coreCard,
.offerCard {
  padding: 18px;
}

.coreCard {
  cursor: pointer;
}

.coreCard p,
.offerCard p,
.detailPanel p,
.suggestionStack p {
  color: var(--muted);
  line-height: 1.55;
}

.cardTopline,
.valueRow,
.cardActions,
.memoryControls {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 10px;
}

.cardTopline {
  justify-content: space-between;
  margin-bottom: 12px;
}

.valueRow {
  margin: 14px 0;
}

.valueRow strong {
  color: var(--gold-2);
}

.cardActions {
  margin-top: 14px;
}

.cardActions button,
.memoryControls button,
.ghostButton {
  padding: 9px 12px;
  font-size: 13px;
}

.stackedActions {
  flex-direction: column;
  align-items: stretch;
}

.detailList {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 10px;
  margin: 18px 0;
}

.detailList span {
  padding: 12px;
  border: 1px solid rgba(102, 145, 200, 0.17);
  border-radius: 16px;
  background: rgba(255, 255, 255, 0.035);
}

.detailList strong {
  display: block;
  color: var(--text);
  margin-top: 4px;
}

.offerForm,
.listingForm {
  display: grid;
  gap: 12px;
}

.formPanel {
  max-width: 840px;
  margin: 0 auto;
}

.toggleLine {
  display: flex;
  align-items: center;
  gap: 10px;
  color: var(--muted);
}

.toggleLine input {
  width: auto;
}

.offerList,
.activityFeed,
.suggestionStack {
  display: grid;
  gap: 12px;
}

.offerCard.archived {
  opacity: 0.62;
}

.automationRules {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(230px, 1fr));
  gap: 10px;
  margin-bottom: 24px;
}

.automationRules button {
  display: flex;
  justify-content: space-between;
  border-radius: 18px;
  text-align: left;
}

.automationRules .ruleOn {
  border-color: rgba(85, 230, 165, 0.4);
  background: rgba(85, 230, 165, 0.08);
}

.automationRules .ruleOff {
  border-color: rgba(255, 107, 125, 0.34);
  background: rgba(255, 107, 125, 0.07);
}

.pipelineGrid,
.profileGrid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
  gap: 12px;
}

.pipelineColumn {
  min-height: 142px;
  padding: 16px;
}

.pipelineColumn strong {
  display: block;
}

.pipelineColumn span {
  display: inline-flex;
  margin: 10px 0;
  border-radius: 999px;
  padding: 5px 10px;
  color: var(--gold-2);
  background: rgba(244, 201, 107, 0.08);
}

.pipelineColumn p {
  margin: 6px 0 0;
  color: var(--muted);
  font-size: 13px;
}

.activityFeed article,
.suggestionStack p,
.emptyState {
  border: 1px solid rgba(102, 145, 200, 0.17);
  border-radius: 18px;
  padding: 13px;
  background: rgba(255, 255, 255, 0.035);
}

.activityFeed strong {
  display: block;
  margin-bottom: 5px;
  color: var(--gold-2);
}

.memoryControls {
  margin-top: 22px;
}

@media (max-width: 1050px) {
  .heroPanel,
  .sectionHeader {
    flex-direction: column;
  }

  .heroBadges {
    justify-content: flex-start;
  }

  .statsGrid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .layoutGrid {
    grid-template-columns: 1fr;
  }
}

@media (max-width: 560px) {
  .sellcoreApp {
    width: min(100% - 16px, 1480px);
    padding-top: 10px;
  }

  .heroPanel,
  .panel {
    border-radius: 22px;
  }

  .statsGrid {
    grid-template-columns: 1fr;
  }

  .detailList {
    grid-template-columns: 1fr;
  }
}

/* Block 8 — Discovery + Trust Marketplace Expansion */
.discoveryPanel {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
  gap: 10px;
  margin-bottom: 14px;
  padding: 14px;
  border: 1px solid rgba(102, 145, 200, 0.17);
  border-radius: 22px;
  background: rgba(255, 255, 255, 0.035);
}

.discoveryPanel input {
  grid-column: span 2;
}

.resultLine {
  color: var(--muted);
  margin-bottom: 14px;
}

.trustStrip {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
  margin: 12px 0 2px;
}

.trustStrip span,
.qualityChecklist span,
.sellerBoxSelector,
.trustBreakdown {
  border: 1px solid rgba(102, 145, 200, 0.17);
  border-radius: 16px;
  padding: 9px 11px;
  color: var(--muted);
  background: rgba(255, 255, 255, 0.035);
  font-size: 13px;
}

.qualityChecklist,
.sellerBoxSelector,
.trustBreakdown {
  display: grid;
  gap: 10px;
  margin: 16px 0;
}

.qualityChecklist h3,
.sellerBoxSelector h3,
.trustBreakdown h3 {
  margin-bottom: 0;
}

.qualityChecklist span {
  display: block;
}

.qualityChecklist .checkPass {
  border-color: rgba(85, 230, 165, 0.38);
  color: var(--green);
  background: rgba(85, 230, 165, 0.08);
}

.qualityChecklist .checkWait {
  border-color: rgba(244, 201, 107, 0.26);
  color: var(--gold-2);
  background: rgba(244, 201, 107, 0.06);
}

.trustBreakdown p {
  margin-bottom: 0;
  color: var(--muted);
  line-height: 1.55;
}

@media (max-width: 560px) {
  .discoveryPanel input {
    grid-column: span 1;
  }
}


/* 09 — Profile Navigation + Marketplace Polish */
.blockNineApp {
  padding-bottom: 108px;
}

.blockNineHero h1 {
  max-width: 920px;
}

.blockNineStats {
  position: sticky;
  top: 10px;
  z-index: 5;
}

.bottomIconNav {
  position: fixed;
  left: 50%;
  bottom: 16px;
  transform: translateX(-50%);
  z-index: 50;
  display: grid;
  grid-template-columns: repeat(6, minmax(48px, 1fr));
  gap: 8px;
  width: min(820px, calc(100% - 24px));
  padding: 8px;
  border: 1px solid rgba(244, 201, 107, 0.28);
  border-radius: 28px;
  background: rgba(3, 10, 20, 0.86);
  box-shadow: 0 18px 50px rgba(0, 0, 0, 0.48);
  backdrop-filter: blur(18px);
}

.bottomIconNav button {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 3px;
  min-height: 58px;
  padding: 8px 6px;
  border-radius: 22px;
}

.bottomIconNav button span {
  font-size: 20px;
  line-height: 1;
}

.bottomIconNav button strong {
  font-size: 10px;
  letter-spacing: 0.04em;
  text-transform: uppercase;
}

.bottomIconNav button.active {
  color: #07111f;
  border-color: rgba(244, 201, 107, 0.9);
  background: linear-gradient(135deg, var(--gold), #fff1b9);
}

.filterActionRail {
  display: flex;
  gap: 10px;
  overflow-x: auto;
  padding: 8px 0 14px;
  margin-bottom: 8px;
}

.filterActionRail button {
  white-space: nowrap;
}

.filterActionRail button.activeFilterAction {
  color: #07111f;
  border-color: rgba(244, 201, 107, 0.92);
  background: linear-gradient(135deg, var(--gold), #fff1b9);
  font-weight: 900;
}

.blockNineDiscovery {
  margin-top: 8px;
}

.miniListingStack,
.personaList,
.historyTimeline {
  display: grid;
  gap: 12px;
}

.miniListingButton {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 14px;
  width: 100%;
  border-radius: 22px;
  text-align: left;
}

.miniListingButton span {
  color: var(--muted);
  font-size: 13px;
}

.selectedCoreCard {
  border-color: rgba(244, 201, 107, 0.8);
  box-shadow: 0 20px 62px rgba(244, 201, 107, 0.12);
}

.activePersonaCard,
.personaCard,
.historyTimeline article {
  border: 1px solid var(--line);
  border-radius: 24px;
  padding: 18px;
  background: rgba(255, 255, 255, 0.045);
}

.activePersonaCard h2 {
  margin: 12px 0 4px;
}

.personaGrid {
  display: grid;
  grid-template-columns: repeat(2, minmax(160px, 1fr));
  gap: 10px;
  margin-top: 14px;
}

.personaGrid span {
  display: grid;
  gap: 4px;
  padding: 12px;
  border: 1px solid var(--line);
  border-radius: 18px;
  color: var(--muted);
}

.personaGrid strong {
  color: var(--text);
}

.personaCard p,
.historyTimeline p {
  color: var(--muted);
}

.historyTimeline article {
  display: grid;
  gap: 7px;
}

.historyTimeline small {
  color: var(--muted);
}

.compactSelect {
  max-width: 190px;
}

@media (max-width: 820px) {
  .bottomIconNav {
    grid-template-columns: repeat(6, 1fr);
    bottom: 10px;
    border-radius: 24px;
  }

  .bottomIconNav button {
    min-height: 54px;
    padding: 7px 4px;
  }

  .bottomIconNav button strong {
    font-size: 9px;
  }

  .personaGrid {
    grid-template-columns: 1fr;
  }

  .miniListingButton {
    align-items: flex-start;
    flex-direction: column;
  }
}

/* =========================================
   SellCore Slim Width Polish Patch
   Purpose: slightly slimmer, sleeker app feel
   ========================================= */

html,
body,
#root {
  width: 100%;
  max-width: 100%;
  overflow-x: hidden;
}

body {
  display: flex;
  justify-content: center;
}

#root {
  display: flex;
  justify-content: center;
}

.appShell,
.app-shell,
.sellcore-shell,
.sellcoreShell,
.core-shell,
.coreShell,
.marketplace-shell,
.marketplaceShell {
  width: min(100%, 460px);
  max-width: 460px;
  margin-left: auto;
  margin-right: auto;
  padding-left: 12px;
  padding-right: 12px;
  box-sizing: border-box;
}

.card,
.core-card,
.coreCard,
.panel,
.market-panel,
.marketPanel,
.profile-panel,
.profilePanel,
.utility-panel,
.utilityPanel {
  max-width: 100%;
  box-sizing: border-box;
}

@media (max-width: 430px) {
  .appShell,
  .app-shell,
  .sellcore-shell,
  .sellcoreShell,
  .core-shell,
  .coreShell,
  .marketplace-shell,
  .marketplaceShell {
    width: 100%;
    max-width: 100%;
    padding-left: 10px;
    padding-right: 10px;
  }

  .card,
  .core-card,
  .coreCard,
  .panel,
  .market-panel,
  .marketPanel,
  .profile-panel,
  .profilePanel,
  .utility-panel,
  .utilityPanel {
    padding-left: 14px;
    padding-right: 14px;
  }
}

@media (min-width: 900px) {
  .appShell,
  .app-shell,
  .sellcore-shell,
  .sellcoreShell,
  .core-shell,
  .coreShell,
  .marketplace-shell,
  .marketplaceShell {
    max-width: 480px;
  }
}
