:root {
  --bg: #07111f;
  --panel: rgba(10, 24, 43, 0.86);
  --panel-2: rgba(15, 35, 60, 0.78);
  --line: rgba(102, 145, 200, 0.22);
  --text: #eef6ff;
  --muted: #9fb1ca;
  --gold: #f4c96b;
  --gold-2: #ffe2a1;
  --blue: #4aa3ff;
  --deep-blue: #081b33;
  --green: #55e6a5;
  --red: #ff6b7d;
  --shadow: rgba(0, 0, 0, 0.28);
  font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
  color: var(--text);
  background: var(--bg);
}

* {
  box-sizing: border-box;
}

body {
  margin: 0;
  min-width: 320px;
  min-height: 100vh;
  background:
    radial-gradient(circle at 15% 5%, rgba(74, 163, 255, 0.23), transparent 35%),
    radial-gradient(circle at 85% 15%, rgba(244, 201, 107, 0.18), transparent 30%),
    linear-gradient(145deg, #050a13, #071a2f 55%, #060b15);
}

button,
input,
textarea,
select {
  font: inherit;
}

button {
  border: 1px solid rgba(244, 201, 107, 0.32);
  border-radius: 999px;
  padding: 10px 14px;
  color: var(--text);
  background: rgba(255, 255, 255, 0.055);
  cursor: pointer;
  transition: transform 160ms ease, border-color 160ms ease, background 160ms ease;
}

button:hover {
  transform: translateY(-1px);
  border-color: rgba(244, 201, 107, 0.78);
  background: rgba(244, 201, 107, 0.10);
}

input,
textarea,
select {
  width: 100%;
  border: 1px solid rgba(102, 145, 200, 0.26);
  border-radius: 18px;
  padding: 12px 14px;
  color: var(--text);
  background: rgba(2, 10, 20, 0.66);
  outline: none;
}

textarea {
  min-height: 112px;
  resize: vertical;
}

select option {
  background: #07111f;
  color: var(--text);
}

.sellcoreApp {
  width: min(1480px, calc(100% - 28px));
  margin: 0 auto;
  padding: 24px 0 44px;
}

.heroPanel,
.panel,
.statsGrid article,
.coreCard,
.offerCard,
.pipelineColumn {
  border: 1px solid var(--line);
  border-radius: 28px;
  background:
    linear-gradient(145deg, rgba(255, 255, 255, 0.065), rgba(255, 255, 255, 0.025)),
    var(--panel);
  box-shadow: 0 18px 46px var(--shadow);
  backdrop-filter: blur(18px);
}

.heroPanel {
  display: flex;
  justify-content: space-between;
  gap: 20px;
  padding: clamp(22px, 4vw, 42px);
  overflow: hidden;
  position: relative;
}

.heroPanel::after {
  content: "";
  position: absolute;
  inset: auto -60px -80px auto;
  width: 280px;
  height: 280px;
  border-radius: 999px;
  background: radial-gradient(circle, rgba(244, 201, 107, 0.22), transparent 65%);
  pointer-events: none;
}

.eyebrow {
  margin: 0 0 8px;
  color: var(--gold);
  font-size: 12px;
  font-weight: 800;
  letter-spacing: 0.14em;
  text-transform: uppercase;
}

h1,
h2,
h3,
p {
  margin-top: 0;
}

h1 {
  margin-bottom: 12px;
  font-size: clamp(42px, 8vw, 88px);
  line-height: 0.92;
  letter-spacing: -0.07em;
}

h2 {
  margin-bottom: 12px;
  font-size: clamp(26px, 3vw, 42px);
  letter-spacing: -0.045em;
}

h3 {
  margin-bottom: 10px;
  font-size: 21px;
  letter-spacing: -0.025em;
}

.heroCopy {
  max-width: 760px;
  color: var(--muted);
  font-size: 18px;
  line-height: 1.6;
}

.heroBadges {
  display: flex;
  flex-wrap: wrap;
  align-content: flex-start;
  justify-content: flex-end;
  gap: 10px;
  min-width: min(420px, 100%);
}

.badge,
.statusPill {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  border: 1px solid rgba(102, 145, 200, 0.25);
  border-radius: 999px;
  padding: 7px 11px;
  color: var(--muted);
  background: rgba(255, 255, 255, 0.055);
  font-size: 12px;
  font-weight: 750;
}

.badge.gold,
.statusPill.negotiating,
.statusPill.seller-box-requested {
  border-color: rgba(244, 201, 107, 0.55);
  color: var(--gold-2);
  background: rgba(244, 201, 107, 0.10);
}

.badge.live,
.statusPill.available,
.statusPill.completed {
  border-color: rgba(85, 230, 165, 0.55);
  color: var(--green);
  background: rgba(85, 230, 165, 0.09);
}

.badge.muted,
.statusPill.archived,
.archived-pill {
  border-color: rgba(255, 107, 125, 0.44);
  color: #ffadba;
  background: rgba(255, 107, 125, 0.08);
}

.tabBar {
  display: flex;
  flex-wrap: wrap;
  gap: 10px;
  margin: 18px 0;
  padding: 8px;
  border: 1px solid var(--line);
  border-radius: 999px;
  background: rgba(3, 10, 20, 0.45);
}

.tabBar button {
  flex: 1 1 150px;
}

.tabBar button.active,
.primaryButton {
  border-color: rgba(244, 201, 107, 0.78);
  color: #08111f;
  background: linear-gradient(135deg, var(--gold), #fff1b9);
  font-weight: 900;
}

.statsGrid {
  display: grid;
  grid-template-columns: repeat(5, minmax(130px, 1fr));
  gap: 12px;
  margin-bottom: 18px;
}

.statsGrid article,
.profileGrid article {
  padding: 18px;
}

.statsGrid span,
.profileGrid span,
.detailList span,
.valueRow span,
.activityFeed span,
.pipelineColumn span {
  color: var(--muted);
  font-size: 13px;
}

.statsGrid strong,
.profileGrid strong {
  display: block;
  margin-top: 7px;
  color: var(--gold-2);
  font-size: 30px;
}

.layoutGrid {
  display: grid;
  grid-template-columns: minmax(0, 1.7fr) minmax(330px, 0.8fr);
  gap: 18px;
}

.panel {
  padding: clamp(18px, 3vw, 28px);
}

.sectionHeader {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 14px;
  margin-bottom: 18px;
}

.cardGrid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(270px, 1fr));
  gap: 14px;
}

.coreCard,
.offerCard {
  padding: 18px;
}

.coreCard {
  cursor: pointer;
}

.coreCard p,
.offerCard p,
.detailPanel p,
.suggestionStack p {
  color: var(--muted);
  line-height: 1.55;
}

.cardTopline,
.valueRow,
.cardActions,
.memoryControls {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 10px;
}

.cardTopline {
  justify-content: space-between;
  margin-bottom: 12px;
}

.valueRow {
  margin: 14px 0;
}

.valueRow strong {
  color: var(--gold-2);
}

.cardActions {
  margin-top: 14px;
}

.cardActions button,
.memoryControls button,
.ghostButton {
  padding: 9px 12px;
  font-size: 13px;
}

.stackedActions {
  flex-direction: column;
  align-items: stretch;
}

.detailList {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 10px;
  margin: 18px 0;
}

.detailList span {
  padding: 12px;
  border: 1px solid rgba(102, 145, 200, 0.17);
  border-radius: 16px;
  background: rgba(255, 255, 255, 0.035);
}

.detailList strong {
  display: block;
  color: var(--text);
  margin-top: 4px;
}

.offerForm,
.listingForm {
  display: grid;
  gap: 12px;
}

.formPanel {
  max-width: 840px;
  margin: 0 auto;
}

.toggleLine {
  display: flex;
  align-items: center;
  gap: 10px;
  color: var(--muted);
}

.toggleLine input {
  width: auto;
}

.offerList,
.activityFeed,
.suggestionStack {
  display: grid;
  gap: 12px;
}

.offerCard.archived {
  opacity: 0.62;
}

.automationRules {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(230px, 1fr));
  gap: 10px;
  margin-bottom: 24px;
}

.automationRules button {
  display: flex;
  justify-content: space-between;
  border-radius: 18px;
  text-align: left;
}

.automationRules .ruleOn {
  border-color: rgba(85, 230, 165, 0.4);
  background: rgba(85, 230, 165, 0.08);
}

.automationRules .ruleOff {
  border-color: rgba(255, 107, 125, 0.34);
  background: rgba(255, 107, 125, 0.07);
}

.pipelineGrid,
.profileGrid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
  gap: 12px;
}

.pipelineColumn {
  min-height: 142px;
  padding: 16px;
}

.pipelineColumn strong {
  display: block;
}

.pipelineColumn span {
  display: inline-flex;
  margin: 10px 0;
  border-radius: 999px;
  padding: 5px 10px;
  color: var(--gold-2);
  background: rgba(244, 201, 107, 0.08);
}

.pipelineColumn p {
  margin: 6px 0 0;
  color: var(--muted);
  font-size: 13px;
}

.activityFeed article,
.suggestionStack p,
.emptyState {
  border: 1px solid rgba(102, 145, 200, 0.17);
  border-radius: 18px;
  padding: 13px;
  background: rgba(255, 255, 255, 0.035);
}

.activityFeed strong {
  display: block;
  margin-bottom: 5px;
  color: var(--gold-2);
}

.memoryControls {
  margin-top: 22px;
}

@media (max-width: 1050px) {
  .heroPanel,
  .sectionHeader {
    flex-direction: column;
  }

  .heroBadges {
    justify-content: flex-start;
  }

  .statsGrid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .layoutGrid {
    grid-template-columns: 1fr;
  }
}

@media (max-width: 560px) {
  .sellcoreApp {
    width: min(100% - 16px, 1480px);
    padding-top: 10px;
  }

  .heroPanel,
  .panel {
    border-radius: 22px;
  }

  .statsGrid {
    grid-template-columns: 1fr;
  }

  .detailList {
    grid-template-columns: 1fr;
  }
}

/* Block 8 — Discovery + Trust Marketplace Expansion */
.discoveryPanel {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
  gap: 10px;
  margin-bottom: 14px;
  padding: 14px;
  border: 1px solid rgba(102, 145, 200, 0.17);
  border-radius: 22px;
  background: rgba(255, 255, 255, 0.035);
}

.discoveryPanel input {
  grid-column: span 2;
}

.resultLine {
  color: var(--muted);
  margin-bottom: 14px;
}

.trustStrip {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
  margin: 12px 0 2px;
}

.trustStrip span,
.qualityChecklist span,
.sellerBoxSelector,
.trustBreakdown {
  border: 1px solid rgba(102, 145, 200, 0.17);
  border-radius: 16px;
  padding: 9px 11px;
  color: var(--muted);
  background: rgba(255, 255, 255, 0.035);
  font-size: 13px;
}

.qualityChecklist,
.sellerBoxSelector,
.trustBreakdown {
  display: grid;
  gap: 10px;
  margin: 16px 0;
}

.qualityChecklist h3,
.sellerBoxSelector h3,
.trustBreakdown h3 {
  margin-bottom: 0;
}

.qualityChecklist span {
  display: block;
}

.qualityChecklist .checkPass {
  border-color: rgba(85, 230, 165, 0.38);
  color: var(--green);
  background: rgba(85, 230, 165, 0.08);
}

.qualityChecklist .checkWait {
  border-color: rgba(244, 201, 107, 0.26);
  color: var(--gold-2);
  background: rgba(244, 201, 107, 0.06);
}

.trustBreakdown p {
  margin-bottom: 0;
  color: var(--muted);
  line-height: 1.55;
}

@media (max-width: 560px) {
  .discoveryPanel input {
    grid-column: span 1;
  }
}


/* 09 — Profile Navigation + Marketplace Polish */
.blockNineApp {
  padding-bottom: 108px;
}

.blockNineHero h1 {
  max-width: 920px;
}

.blockNineStats {
  position: sticky;
  top: 10px;
  z-index: 5;
}

.bottomIconNav {
  position: fixed;
  left: 50%;
  bottom: 16px;
  transform: translateX(-50%);
  z-index: 50;
  display: grid;
  grid-template-columns: repeat(6, minmax(48px, 1fr));
  gap: 8px;
  width: min(820px, calc(100% - 24px));
  padding: 8px;
  border: 1px solid rgba(244, 201, 107, 0.28);
  border-radius: 28px;
  background: rgba(3, 10, 20, 0.86);
  box-shadow: 0 18px 50px rgba(0, 0, 0, 0.48);
  backdrop-filter: blur(18px);
}

.bottomIconNav button {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 3px;
  min-height: 58px;
  padding: 8px 6px;
  border-radius: 22px;
}

.bottomIconNav button span {
  font-size: 20px;
  line-height: 1;
}

.bottomIconNav button strong {
  font-size: 10px;
  letter-spacing: 0.04em;
  text-transform: uppercase;
}

.bottomIconNav button.active {
  color: #07111f;
  border-color: rgba(244, 201, 107, 0.9);
  background: linear-gradient(135deg, var(--gold), #fff1b9);
}

.filterActionRail {
  display: flex;
  gap: 10px;
  overflow-x: auto;
  padding: 8px 0 14px;
  margin-bottom: 8px;
}

.filterActionRail button {
  white-space: nowrap;
}

.filterActionRail button.activeFilterAction {
  color: #07111f;
  border-color: rgba(244, 201, 107, 0.92);
  background: linear-gradient(135deg, var(--gold), #fff1b9);
  font-weight: 900;
}

.blockNineDiscovery {
  margin-top: 8px;
}

.miniListingStack,
.personaList,
.historyTimeline {
  display: grid;
  gap: 12px;
}

.miniListingButton {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 14px;
  width: 100%;
  border-radius: 22px;
  text-align: left;
}

.miniListingButton span {
  color: var(--muted);
  font-size: 13px;
}

.selectedCoreCard {
  border-color: rgba(244, 201, 107, 0.8);
  box-shadow: 0 20px 62px rgba(244, 201, 107, 0.12);
}

.activePersonaCard,
.personaCard,
.historyTimeline article {
  border: 1px solid var(--line);
  border-radius: 24px;
  padding: 18px;
  background: rgba(255, 255, 255, 0.045);
}

.activePersonaCard h2 {
  margin: 12px 0 4px;
}

.personaGrid {
  display: grid;
  grid-template-columns: repeat(2, minmax(160px, 1fr));
  gap: 10px;
  margin-top: 14px;
}

.personaGrid span {
  display: grid;
  gap: 4px;
  padding: 12px;
  border: 1px solid var(--line);
  border-radius: 18px;
  color: var(--muted);
}

.personaGrid strong {
  color: var(--text);
}

.personaCard p,
.historyTimeline p {
  color: var(--muted);
}

.historyTimeline article {
  display: grid;
  gap: 7px;
}

.historyTimeline small {
  color: var(--muted);
}

.compactSelect {
  max-width: 190px;
}

@media (max-width: 820px) {
  .bottomIconNav {
    grid-template-columns: repeat(6, 1fr);
    bottom: 10px;
    border-radius: 24px;
  }

  .bottomIconNav button {
    min-height: 54px;
    padding: 7px 4px;
  }

  .bottomIconNav button strong {
    font-size: 9px;
  }

  .personaGrid {
    grid-template-columns: 1fr;
  }

  .miniListingButton {
    align-items: flex-start;
    flex-direction: column;
  }
}


/* =========================================
   10 — Profile Media + Feed Output
   Preserves Foundation 09 mobile polish while adding camera/images
   ========================================= */
:root {
  --sellcore-mobile-width: 430px;
  --sellcore-desktop-width: 760px;
  --sellcore-bottom-nav-height: 58px;
  --sellcore-shell-padding-mobile: 7px;
  --sellcore-shell-padding-desktop: 18px;
  --sellcore-font-main: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
  --sellcore-font-weight-body: 480;
  --sellcore-font-weight-strong: 620;
  --sellcore-font-weight-title: 670;
  --sellcore-font-weight-button: 600;
}

html,
body,
#root {
  width: 100%;
  max-width: 100%;
  overflow-x: hidden;
}

html {
  font-size: 83.3%;
}

body,
button,
input,
select,
textarea {
  font-family: var(--sellcore-font-main);
  font-weight: var(--sellcore-font-weight-body);
  letter-spacing: 0.01em;
  text-rendering: geometricPrecision;
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
}

body {
  display: flex;
  justify-content: center;
}

#root {
  display: flex;
  justify-content: center;
}

.sellcoreApp.blockTenApp,
.sellcoreApp.blockNineApp {
  width: 100%;
  max-width: var(--sellcore-mobile-width);
  margin-left: auto;
  margin-right: auto;
  padding-left: var(--sellcore-shell-padding-mobile);
  padding-right: var(--sellcore-shell-padding-mobile);
  padding-top: 6px;
  padding-bottom: calc(var(--sellcore-bottom-nav-height) + 22px);
  box-sizing: border-box;
}

.blockTenApp h1,
.blockTenApp h2,
.blockTenApp h3,
.blockTenApp .cardTitle,
.blockTenApp .sectionTitle {
  font-weight: var(--sellcore-font-weight-title);
  letter-spacing: -0.018em;
}

.blockTenApp p,
.blockTenApp li,
.blockTenApp label,
.blockTenApp input,
.blockTenApp select,
.blockTenApp textarea,
.blockTenApp .card,
.blockTenApp .panel,
.blockTenApp .coreCard {
  font-size: 0.92rem;
}

.blockTenApp .eyebrow,
.blockTenApp .meta,
.blockTenApp .subtext,
.blockTenApp .helperText,
.blockTenApp .description,
.blockTenApp .note,
.blockTenApp .timestamp,
.blockTenApp small {
  font-size: 0.78rem;
}

.blockTenApp button,
.blockTenApp .button,
.blockTenApp .actionButton,
.blockTenApp .primaryButton,
.blockTenApp .secondaryButton,
.blockTenApp .navButton,
.blockTenApp .filterButton,
.blockTenApp .utilityButton {
  font-size: 0.78rem;
  font-weight: var(--sellcore-font-weight-button);
  letter-spacing: 0.035em;
  text-transform: none;
}

.blockTenApp strong,
.blockTenApp b,
.blockTenApp .badge,
.blockTenApp .pill,
.blockTenApp .status,
.blockTenApp .statusBadge,
.blockTenApp .trustBadge,
.blockTenApp .valueBadge,
.blockTenApp .coreBadge,
.blockTenApp .marketBadge {
  font-weight: var(--sellcore-font-weight-strong);
}

.mediaFrame,
.profileBanner {
  width: 100%;
  overflow: hidden;
  border: 1px solid rgba(102, 145, 200, 0.24);
  border-radius: 20px;
  background:
    radial-gradient(circle at 15% 20%, rgba(74, 163, 255, 0.18), transparent 42%),
    radial-gradient(circle at 85% 20%, rgba(244, 201, 107, 0.14), transparent 38%),
    rgba(2, 10, 20, 0.58);
  box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.05);
}

.mediaFrame img,
.profileBanner img {
  display: block;
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.listingMedia {
  aspect-ratio: 16 / 10;
  margin: 0 0 12px;
}

.detailMedia,
.draftMedia {
  aspect-ratio: 16 / 9;
  margin: 12px 0;
}

.emptyMediaFrame {
  min-height: 112px;
  display: grid;
  place-items: center;
  color: var(--muted);
  font-size: 0.76rem;
  letter-spacing: 0.04em;
  text-transform: uppercase;
}

.mediaUploader {
  display: grid;
  gap: 10px;
  padding: 12px;
  border: 1px dashed rgba(244, 201, 107, 0.32);
  border-radius: 20px;
  background: rgba(244, 201, 107, 0.055);
}

.mediaUploader > div:first-child,
.profileMediaBuilder > span,
.mediaUploader span {
  color: var(--muted);
}

.profileIdentityRow {
  display: flex;
  align-items: center;
  gap: 12px;
  margin-top: 12px;
}

.profileAvatar,
.miniAvatar {
  flex: 0 0 auto;
  width: 72px;
  height: 72px;
  border-radius: 24px;
  object-fit: cover;
  border: 1px solid rgba(244, 201, 107, 0.42);
  background: rgba(244, 201, 107, 0.10);
}

.miniAvatar {
  width: 44px;
  height: 44px;
  border-radius: 15px;
  margin-bottom: 8px;
}

.placeholderAvatar {
  display: grid;
  place-items: center;
  color: var(--gold-2);
  font-weight: 750;
}

.profileBanner {
  aspect-ratio: 21 / 7;
  margin: 0 0 12px;
}

.compactBanner,
.emptyBanner {
  min-height: 74px;
  display: grid;
  place-items: center;
  color: var(--muted);
}

.profilePreviewRow {
  display: grid;
  grid-template-columns: 80px 1fr;
  gap: 10px;
  align-items: center;
}

.mediaProfileActions {
  margin-top: 14px;
}

.messageOutline,
.mediaChecklist {
  display: grid;
  gap: 8px;
  padding: 12px;
  border: 1px solid rgba(102, 145, 200, 0.22);
  border-radius: 18px;
  background: rgba(255, 255, 255, 0.035);
}

.messageOutline p,
.mediaChecklist p {
  margin: 0;
  color: var(--muted);
}

@media (max-width: 430px) {
  :root {
    --sellcore-mobile-width: 430px;
    --sellcore-bottom-nav-height: 58px;
    --sellcore-shell-padding-mobile: 7px;
  }

  html {
    font-size: 76%;
  }

  .sellcoreApp.blockTenApp,
  .sellcoreApp.blockNineApp {
    max-width: 100%;
    width: 100%;
    padding-left: 7px;
    padding-right: 7px;
    padding-top: 6px;
    padding-bottom: calc(var(--sellcore-bottom-nav-height) + 22px);
  }

  .heroPanel,
  header,
  .header,
  .appHeader,
  .app-header,
  .hero,
  .heroPanel,
  .hero-panel,
  .topPanel,
  .top-panel {
    padding: 10px;
    margin-bottom: 8px;
  }

  section,
  article,
  .card,
  .coreCard,
  .panel,
  .marketPanel,
  .profilePanel,
  .utilityPanel,
  .listingCard,
  .offerCard {
    padding: 10px;
    margin-bottom: 8px;
    border-radius: 16px;
  }

  .grid,
  .feedGrid,
  .marketGrid,
  .sectionGrid,
  .cardGrid,
  .layoutGrid,
  .statsGrid {
    gap: 8px;
  }

  .blockTenApp h1 {
    font-size: clamp(1.28rem, 6vw, 1.7rem);
    line-height: 1.02;
    margin-bottom: 6px;
  }

  .blockTenApp h2 {
    font-size: clamp(1.05rem, 5vw, 1.38rem);
    line-height: 1.05;
    margin-bottom: 5px;
  }

  .blockTenApp h3 {
    font-size: clamp(0.92rem, 4.4vw, 1.12rem);
    line-height: 1.08;
    margin-bottom: 4px;
  }

  .blockTenApp p,
  .blockTenApp li,
  .blockTenApp label,
  .blockTenApp input,
  .blockTenApp select,
  .blockTenApp textarea,
  .blockTenApp .coreCard,
  .blockTenApp .panel {
    font-size: 0.82rem;
    line-height: 1.35;
  }

  .blockTenApp .meta,
  .blockTenApp .subtext,
  .blockTenApp .helperText,
  .blockTenApp .description,
  .blockTenApp .note,
  .blockTenApp small {
    font-size: 0.68rem;
    line-height: 1.32;
  }

  .blockTenApp button,
  .blockTenApp .button,
  .blockTenApp .actionButton,
  .blockTenApp .primaryButton,
  .blockTenApp .secondaryButton,
  .blockTenApp .navButton,
  .blockTenApp .filterButton,
  .blockTenApp .utilityButton {
    padding: 7px 8px;
    font-size: 0.68rem;
    border-radius: 13px;
    min-height: 0;
  }

  .bottomIconNav {
    left: 50%;
    bottom: calc(6px + env(safe-area-inset-bottom));
    transform: translateX(-50%);
    width: calc(100% - 14px);
    max-width: calc(var(--sellcore-mobile-width) - 12px);
    min-height: 58px;
    padding: 5px;
    gap: 3px;
    border-radius: 18px;
    grid-template-columns: repeat(6, minmax(42px, 1fr));
    overflow: hidden;
  }

  .bottomIconNav button {
    min-width: 0;
    min-height: 0;
    width: 100%;
    max-width: 100%;
    padding: 5px 2px;
    font-size: 0.54rem;
    line-height: 1;
    border-radius: 12px;
    gap: 2px;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .bottomIconNav button span {
    font-size: 0.9rem;
    line-height: 1;
  }

  .bottomIconNav button strong,
  .navLabel,
  .utilityLabel,
  .tabLabel,
  .buttonLabel {
    font-size: 0.5rem;
    line-height: 1;
    max-width: 100%;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .profileIdentityRow {
    gap: 9px;
  }

  .profileAvatar {
    width: 58px;
    height: 58px;
    border-radius: 20px;
  }

  .listingMedia,
  .detailMedia,
  .draftMedia {
    border-radius: 16px;
  }

  .emptyMediaFrame {
    min-height: 92px;
  }
}

@media (max-width: 390px) {
  html {
    font-size: 74%;
  }

  .sellcoreApp.blockTenApp,
  .sellcoreApp.blockNineApp {
    padding-left: 6px;
    padding-right: 6px;
  }

  .bottomIconNav {
    width: calc(100% - 10px);
    min-height: 54px;
  }

  .bottomIconNav button strong {
    font-size: 0.48rem;
  }
}

@media (min-width: 760px) {
  .sellcoreApp.blockTenApp,
  .sellcoreApp.blockNineApp {
    max-width: var(--sellcore-desktop-width);
    padding-left: var(--sellcore-shell-padding-desktop);
    padding-right: var(--sellcore-shell-padding-desktop);
  }

  .bottomIconNav {
    max-width: 540px;
  }
}

/* =========================================
   SellCore Block 11 Save Everything Polish
   Workspace continuity + save controls
   ========================================= */

.headerActions {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  flex-wrap: wrap;
  gap: 8px;
}

.headerActions button {
  min-width: 0;
}

.mediaChecklist p {
  border-left: 2px solid rgba(218, 184, 95, 0.52);
  padding-left: 9px;
}

.memoryControls {
  display: grid;
  grid-template-columns: 1fr;
  gap: 8px;
}

.memoryControls button {
  width: 100%;
}

@media (max-width: 430px) {
  .headerActions {
    width: 100%;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 6px;
  }

  .headerActions button {
    padding: 6px 5px;
    font-size: 0.56rem;
  }

  .memoryControls {
    gap: 6px;
  }
}

/* =========================================
   SellCore Builder Header Polish
   Compact top identity + hidden builder tools
   ========================================= */

.compactFeedHero {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 10px;
  padding: 10px 12px;
  border-radius: 18px;
}

.compactFeedHero::after {
  display: none;
}

.compactBrandStack {
  min-width: 0;
}

.compactBrandLine {
  margin: 0;
  font-size: 0.68rem;
  line-height: 1.05;
  letter-spacing: 0.08em;
}

.compactFoundationLine {
  margin: 3px 0 0;
  color: var(--muted);
  font-size: 0.72rem;
  line-height: 1.1;
  font-weight: 520;
  letter-spacing: 0.018em;
}

.builderTopControl {
  position: relative;
  flex: 0 0 auto;
}

.builderToggleButton {
  border-color: rgba(170, 180, 195, 0.28);
  background: rgba(120, 130, 145, 0.22);
  color: rgba(238, 246, 255, 0.86);
  font-size: 0.62rem;
  padding: 7px 9px;
  border-radius: 999px;
  letter-spacing: 0.035em;
}

.builderTray {
  position: absolute;
  right: 0;
  top: calc(100% + 7px);
  z-index: 90;
  display: grid;
  gap: 6px;
  min-width: 128px;
  padding: 7px;
  border: 1px solid rgba(170, 180, 195, 0.22);
  border-radius: 16px;
  background: rgba(6, 14, 26, 0.96);
  box-shadow: 0 18px 40px rgba(0, 0, 0, 0.42);
  backdrop-filter: blur(16px);
}

.builderTray button {
  width: 100%;
  justify-content: center;
  padding: 7px 8px;
  font-size: 0.64rem;
  border-radius: 12px;
  border-color: rgba(170, 180, 195, 0.22);
  background: rgba(255, 255, 255, 0.055);
}

.builderTray button.activeBuilderAction {
  color: #07111f;
  border-color: rgba(244, 201, 107, 0.85);
  background: linear-gradient(135deg, var(--gold), #fff1b9);
}

.bottomIconNav {
  grid-template-columns: repeat(4, minmax(52px, 1fr));
  max-width: 440px;
}

@media (max-width: 430px) {
  .compactFeedHero {
    padding: 8px 9px;
    border-radius: 15px;
    gap: 7px;
  }

  .compactBrandLine {
    font-size: 0.56rem;
    letter-spacing: 0.06em;
  }

  .compactFoundationLine {
    font-size: 0.6rem;
  }

  .builderToggleButton {
    font-size: 0.52rem;
    padding: 6px 7px;
  }

  .builderTray {
    min-width: 112px;
  }

  .builderTray button {
    font-size: 0.54rem;
    padding: 6px 7px;
  }

  .bottomIconNav {
    grid-template-columns: repeat(4, minmax(46px, 1fr));
    max-width: calc(100% - 12px);
  }
}


/* =========================================
   SellCore Builder Tray + Feed Slide Tabs Fix
   Keeps action buttons in place; moves only builder tools
   ========================================= */

.compactFeedHero {
  position: relative;
  z-index: 80;
  overflow: visible;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 10px;
  padding: 9px 11px;
  border-radius: 17px;
}

.compactFeedHero::after {
  display: none;
}

.compactBrandStack {
  min-width: 0;
  flex: 1;
}

.compactBrandLine {
  margin: 0;
  font-size: 0.64rem;
  line-height: 1.08;
  letter-spacing: 0.075em;
}

.compactFoundationLine {
  margin: 3px 0 0;
  color: var(--muted);
  font-size: 0.68rem;
  line-height: 1.1;
  font-weight: 520;
  letter-spacing: 0.018em;
}

.builderTopControl {
  position: relative;
  z-index: 100;
  flex: 0 0 auto;
}

.builderToggleButton {
  border-color: rgba(170, 180, 195, 0.32);
  background: rgba(122, 130, 144, 0.28);
  color: rgba(238, 246, 255, 0.9);
  font-size: 0.6rem;
  padding: 7px 9px;
  border-radius: 999px;
  letter-spacing: 0.035em;
  white-space: nowrap;
}

.builderTray {
  position: absolute;
  right: 0;
  top: calc(100% + 8px);
  z-index: 999;
  display: grid;
  gap: 6px;
  min-width: 132px;
  padding: 7px;
  border: 1px solid rgba(170, 180, 195, 0.24);
  border-radius: 16px;
  background: rgba(6, 14, 26, 0.98);
  box-shadow: 0 20px 44px rgba(0, 0, 0, 0.46);
  backdrop-filter: blur(16px);
}

.builderTray button {
  width: 100%;
  justify-content: center;
  padding: 7px 8px;
  font-size: 0.62rem;
  border-radius: 12px;
  border-color: rgba(170, 180, 195, 0.22);
  background: rgba(255, 255, 255, 0.06);
}

.builderTray button.activeBuilderAction {
  color: #07111f;
  border-color: rgba(244, 201, 107, 0.85);
  background: linear-gradient(135deg, var(--gold), #fff1b9);
}

.feedSlideTabs {
  display: flex;
  gap: 7px;
  overflow-x: auto;
  overscroll-behavior-x: contain;
  scroll-snap-type: x proximity;
  -webkit-overflow-scrolling: touch;
  padding: 2px 1px 9px;
  margin: 0 0 7px;
}

.feedSlideTabs::-webkit-scrollbar {
  display: none;
}

.feedSlideTabs button {
  flex: 0 0 auto;
  min-width: 82px;
  scroll-snap-align: start;
  display: grid;
  gap: 2px;
  justify-items: start;
  padding: 7px 9px;
  border-radius: 15px;
  background: rgba(255, 255, 255, 0.055);
  border-color: rgba(170, 180, 195, 0.2);
}

.feedSlideTabs button span {
  color: var(--muted);
  font-size: 0.56rem;
  line-height: 1;
  letter-spacing: 0.04em;
}

.feedSlideTabs button strong {
  font-size: 0.86rem;
  line-height: 1;
  font-weight: 650;
}

.feedSlideTabs button.activeSlideTab {
  border-color: rgba(244, 201, 107, 0.65);
  background: rgba(244, 201, 107, 0.11);
}

.bottomIconNav {
  grid-template-columns: repeat(4, minmax(52px, 1fr));
  max-width: 440px;
}

@media (max-width: 430px) {
  .compactFeedHero {
    padding: 8px 8px;
    border-radius: 15px;
    gap: 7px;
  }

  .compactBrandLine {
    font-size: 0.54rem;
    letter-spacing: 0.06em;
  }

  .compactFoundationLine {
    font-size: 0.58rem;
  }

  .builderToggleButton {
    font-size: 0.5rem;
    padding: 6px 7px;
  }

  .builderTray {
    min-width: 116px;
    right: 0;
  }

  .builderTray button {
    font-size: 0.54rem;
    padding: 6px 7px;
  }

  .feedSlideTabs {
    gap: 6px;
    padding-bottom: 8px;
  }

  .feedSlideTabs button {
    min-width: 72px;
    padding: 6px 7px;
    border-radius: 13px;
  }

  .feedSlideTabs button span {
    font-size: 0.5rem;
  }

  .feedSlideTabs button strong {
    font-size: 0.76rem;
  }

  .bottomIconNav {
    grid-template-columns: repeat(4, minmax(46px, 1fr));
    max-width: calc(100% - 12px);
  }
}

/* =========================================
   SellCore Top Menu + Builder Dual Controls
   Three-line feed menu + SellCore Builders side-by-side
   ========================================= */

.compactFeedHero {
  position: relative;
  z-index: 80;
  overflow: visible;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 8px;
  padding: 8px 10px;
  border-radius: 16px;
}

.compactFeedHero::after {
  display: none;
}

.topControlCluster {
  position: relative;
  z-index: 120;
  display: flex;
  align-items: center;
  gap: 6px;
  flex: 0 0 auto;
}

.sideMenuControl,
.builderTopControl {
  position: relative;
  z-index: 130;
}

.sideMenuButton,
.builderToggleButton {
  border-color: rgba(170, 180, 195, 0.3);
  background: rgba(122, 130, 144, 0.28);
  color: rgba(238, 246, 255, 0.92);
  border-radius: 999px;
  white-space: nowrap;
}

.sideMenuButton {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 31px;
  min-width: 31px;
  height: 31px;
  padding: 0;
  font-size: 0.78rem;
  line-height: 1;
}

.builderToggleButton {
  font-size: 0.58rem;
  padding: 7px 8px;
  letter-spacing: 0.03em;
}

.sideMenuTray,
.builderTray {
  position: absolute;
  top: calc(100% + 8px);
  z-index: 999;
  display: grid;
  gap: 6px;
  padding: 7px;
  border: 1px solid rgba(170, 180, 195, 0.24);
  border-radius: 16px;
  background: rgba(6, 14, 26, 0.98);
  box-shadow: 0 20px 44px rgba(0, 0, 0, 0.46);
  backdrop-filter: blur(16px);
}

.sideMenuTray {
  left: 0;
  min-width: 148px;
}

.builderTray {
  left: 0;
  min-width: 122px;
}

.sideMenuTray button,
.builderTray button {
  width: 100%;
  border-radius: 12px;
  border-color: rgba(170, 180, 195, 0.22);
  background: rgba(255, 255, 255, 0.06);
  padding: 7px 8px;
  font-size: 0.6rem;
}

.sideMenuTray button {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 10px;
}

.sideMenuTray button span {
  color: var(--muted);
  font-size: 0.58rem;
}

.sideMenuTray button strong {
  font-size: 0.74rem;
  color: var(--text);
}

.builderTray button {
  justify-content: center;
}

.builderTray button.activeBuilderAction {
  color: #07111f;
  border-color: rgba(244, 201, 107, 0.85);
  background: linear-gradient(135deg, var(--gold), #fff1b9);
}

.rightBrandStack {
  min-width: 0;
  flex: 1;
  text-align: right;
}

.compactBrandLine {
  margin: 0;
  font-size: 0.58rem;
  line-height: 1.08;
  letter-spacing: 0.065em;
}

.compactFoundationLine {
  margin: 3px 0 0;
  color: var(--muted);
  font-size: 0.62rem;
  line-height: 1.1;
  font-weight: 520;
  letter-spacing: 0.016em;
}

.feedSlideTabs,
.statsGrid.blockNineStats {
  display: none !important;
}

.bottomIconNav {
  grid-template-columns: repeat(4, minmax(52px, 1fr));
  max-width: 440px;
}

@media (max-width: 430px) {
  .compactFeedHero {
    padding: 7px 8px;
    gap: 6px;
    border-radius: 15px;
  }

  .topControlCluster {
    gap: 5px;
  }

  .sideMenuButton {
    width: 28px;
    min-width: 28px;
    height: 28px;
    font-size: 0.7rem;
  }

  .builderToggleButton {
    font-size: 0.48rem;
    padding: 6px 6px;
  }

  .sideMenuTray {
    min-width: 132px;
  }

  .builderTray {
    min-width: 108px;
  }

  .sideMenuTray button,
  .builderTray button {
    font-size: 0.52rem;
    padding: 6px 7px;
  }

  .sideMenuTray button span {
    font-size: 0.5rem;
  }

  .sideMenuTray button strong {
    font-size: 0.66rem;
  }

  .compactBrandLine {
    font-size: 0.48rem;
    letter-spacing: 0.052em;
  }

  .compactFoundationLine {
    font-size: 0.52rem;
  }

  .bottomIconNav {
    grid-template-columns: repeat(4, minmax(46px, 1fr));
    max-width: calc(100% - 12px);
  }
}

