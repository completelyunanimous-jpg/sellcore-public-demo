/* =========================================
   SellCore Header Logo + Space Fix
   Compact mobile hero with Core mark
   ========================================= */

/* Compact the main top header/hero card */
header,
.header,
.appHeader,
.app-header,
.hero,
.heroPanel,
.hero-panel,
.topPanel,
.top-panel,
.sellcoreHero,
.sellcore-hero,
.shellHeader,
.shell-header {
  position: relative;
  min-height: unset !important;
  padding: 14px 14px 12px !important;
  margin-bottom: 10px !important;
  display: grid !important;
  grid-template-columns: 54px minmax(0, 1fr) !important;
  grid-template-areas:
    "coremark brand"
    "actions actions" !important;
  column-gap: 12px !important;
  row-gap: 10px !important;
  align-items: center !important;
  overflow: hidden !important;
}

/* CSS-built Core logo mark so no import/image file is needed yet */
header::before,
.header::before,
.appHeader::before,
.app-header::before,
.hero::before,
.heroPanel::before,
.hero-panel::before,
.topPanel::before,
.top-panel::before,
.sellcoreHero::before,
.sellcore-hero::before,
.shellHeader::before,
.shell-header::before {
  content: "";
  grid-area: coremark;
  width: 46px;
  height: 46px;
  border-radius: 50%;
  display: block;
  box-sizing: border-box;
  background:
    radial-gradient(circle at center, rgba(55, 178, 255, 1) 0 13%, rgba(5, 30, 58, 0.96) 14% 28%, rgba(232, 178, 68, 0.95) 29% 31%, transparent 32%),
    radial-gradient(circle at center, transparent 0 48%, rgba(232, 178, 68, 0.78) 49% 51%, transparent 52%),
    linear-gradient(90deg, transparent 0 46%, rgba(232, 178, 68, 0.9) 47% 53%, transparent 54%),
    linear-gradient(0deg, transparent 0 46%, rgba(232, 178, 68, 0.9) 47% 53%, transparent 54%);
  border: 1px solid rgba(232, 178, 68, 0.75);
  box-shadow:
    0 0 18px rgba(55, 178, 255, 0.35),
    0 0 24px rgba(232, 178, 68, 0.18),
    inset 0 0 16px rgba(55, 178, 255, 0.25);
}

/* Make the title/subtitle use the second column */
header h1,
.header h1,
.appHeader h1,
.app-header h1,
.hero h1,
.heroPanel h1,
.hero-panel h1,
.topPanel h1,
.top-panel h1,
.sellcoreHero h1,
.sellcore-hero h1,
.shellHeader h1,
.shell-header h1 {
  grid-area: brand;
  margin: 0 !important;
  align-self: end !important;
  font-size: clamp(0.94rem, 4.4vw, 1.35rem) !important;
  line-height: 1.08 !important;
  letter-spacing: 0.055em !important;
  max-width: 100% !important;
}

/* Subtitle tight under brand text */
header p:first-of-type,
.header p:first-of-type,
.appHeader p:first-of-type,
.app-header p:first-of-type,
.hero p:first-of-type,
.heroPanel p:first-of-type,
.hero-panel p:first-of-type,
.topPanel p:first-of-type,
.top-panel p:first-of-type,
.sellcoreHero p:first-of-type,
.sellcore-hero p:first-of-type,
.shellHeader p:first-of-type,
.shell-header p:first-of-type {
  grid-area: brand;
  margin: 42px 0 0 0 !important;
  font-size: clamp(0.68rem, 3.3vw, 0.86rem) !important;
  line-height: 1.18 !important;
  max-width: 100% !important;
  opacity: 0.86 !important;
}

/* Pull menu + builders controls into a clean bottom row */
header button,
.header button,
.appHeader button,
.app-header button,
.hero button,
.heroPanel button,
.hero-panel button,
.topPanel button,
.top-panel button,
.sellcoreHero button,
.sellcore-hero button,
.shellHeader button,
.shell-header button {
  justify-self: end !important;
  align-self: center !important;
  margin-top: 0 !important;
}

/* Any action area inside the header becomes right-aligned */
header > div:last-child,
.header > div:last-child,
.appHeader > div:last-child,
.app-header > div:last-child,
.hero > div:last-child,
.heroPanel > div:last-child,
.hero-panel > div:last-child,
.topPanel > div:last-child,
.top-panel > div:last-child,
.sellcoreHero > div:last-child,
.sellcore-hero > div:last-child,
.shellHeader > div:last-child,
.shell-header > div:last-child {
  grid-area: actions !important;
  display: flex !important;
  justify-content: flex-end !important;
  align-items: center !important;
  gap: 8px !important;
  width: 100% !important;
}

/* Keep the round menu small and the Builders button sleek */
header button:first-of-type,
.header button:first-of-type,
.appHeader button:first-of-type,
.app-header button:first-of-type,
.hero button:first-of-type,
.heroPanel button:first-of-type,
.hero-panel button:first-of-type,
.topPanel button:first-of-type,
.top-panel button:first-of-type,
.sellcoreHero button:first-of-type,
.sellcore-hero button:first-of-type,
.shellHeader button:first-of-type,
.shell-header button:first-of-type {
  width: 38px !important;
  height: 38px !important;
  min-width: 38px !important;
  padding: 0 !important;
  border-radius: 50% !important;
  font-size: 0.78rem !important;
}

header button:last-of-type,
.header button:last-of-type,
.appHeader button:last-of-type,
.app-header button:last-of-type,
.hero button:last-of-type,
.heroPanel button:last-of-type,
.hero-panel button:last-of-type,
.topPanel button:last-of-type,
.top-panel button:last-of-type,
.sellcoreHero button:last-of-type,
.sellcore-hero button:last-of-type,
.shellHeader button:last-of-type,
.shell-header button:last-of-type {
  min-height: 38px !important;
  padding: 0 14px !important;
  border-radius: 999px !important;
  font-size: 0.68rem !important;
  white-space: nowrap !important;
}

/* Extra mobile tightening */
@media (max-width: 430px) {
  header,
  .header,
  .appHeader,
  .app-header,
  .hero,
  .heroPanel,
  .hero-panel,
  .topPanel,
  .top-panel,
  .sellcoreHero,
  .sellcore-hero,
  .shellHeader,
  .shell-header {
    grid-template-columns: 42px minmax(0, 1fr) !important;
    padding: 11px 11px 10px !important;
    column-gap: 9px !important;
    row-gap: 8px !important;
    border-radius: 18px !important;
  }

  header::before,
  .header::before,
  .appHeader::before,
  .app-header::before,
  .hero::before,
  .heroPanel::before,
  .hero-panel::before,
  .topPanel::before,
  .top-panel::before,
  .sellcoreHero::before,
  .sellcore-hero::before,
  .shellHeader::before,
  .shell-header::before {
    width: 38px;
    height: 38px;
  }

  header h1,
  .header h1,
  .appHeader h1,
  .app-header h1,
  .hero h1,
  .heroPanel h1,
  .hero-panel h1,
  .topPanel h1,
  .top-panel h1,
  .sellcoreHero h1,
  .sellcore-hero h1,
  .shellHeader h1,
  .shell-header h1 {
    font-size: clamp(0.78rem, 4vw, 1.02rem) !important;
    line-height: 1.08 !important;
  }

  header p:first-of-type,
  .header p:first-of-type,
  .appHeader p:first-of-type,
  .app-header p:first-of-type,
  .hero p:first-of-type,
  .heroPanel p:first-of-type,
  .hero-panel p:first-of-type,
  .topPanel p:first-of-type,
  .top-panel p:first-of-type,
  .sellcoreHero p:first-of-type,
  .sellcore-hero p:first-of-type,
  .shellHeader p:first-of-type,
  .shell-header p:first-of-type {
    margin-top: 34px !important;
    font-size: 0.58rem !important;
  }
}

/* =========================================
   SellCore Mobile Frame Specs Patch
   Locks mobile UI into intended phone-app geometry
   ========================================= */

:root {
  --sellcore-phone-frame-width: 390px;
  --sellcore-phone-frame-max: 430px;
  --sellcore-phone-edge-gap: 8px;
  --sellcore-phone-card-radius: 18px;
  --sellcore-phone-bottom-nav-width: calc(100% - 14px);
  --sellcore-phone-bottom-nav-max: 376px;
  --sellcore-phone-bottom-nav-height: 56px;
}

/* Hard overflow protection */
html,
body,
#root {
  width: 100% !important;
  max-width: 100% !important;
  overflow-x: hidden !important;
}

body {
  margin: 0 !important;
  display: flex !important;
  justify-content: center !important;
}

/* Main mobile frame */
@media (max-width: 760px) {
  #root {
    width: 100% !important;
    max-width: var(--sellcore-phone-frame-max) !important;
    margin: 0 auto !important;
    overflow-x: hidden !important;
  }

  .appShell,
  .app-shell,
  .sellcore-shell,
  .sellcoreShell,
  .core-shell,
  .coreShell,
  .marketplace-shell,
  .marketplaceShell,
  main {
    width: 100% !important;
    max-width: var(--sellcore-phone-frame-max) !important;
    margin-left: auto !important;
    margin-right: auto !important;
    padding-left: var(--sellcore-phone-edge-gap) !important;
    padding-right: var(--sellcore-phone-edge-gap) !important;
    padding-bottom: calc(var(--sellcore-phone-bottom-nav-height) + 24px) !important;
    box-sizing: border-box !important;
    overflow-x: hidden !important;
  }

  /* Every major block must stay inside the phone frame */
  header,
  .header,
  .appHeader,
  .app-header,
  .hero,
  .heroPanel,
  .hero-panel,
  .topPanel,
  .top-panel,
  .sellcoreHero,
  .sellcore-hero,
  .shellHeader,
  .shell-header,
  section,
  article,
  .card,
  .core-card,
  .coreCard,
  .panel,
  .market-panel,
  .marketPanel,
  .profile-panel,
  .profilePanel,
  .utility-panel,
  .utilityPanel,
  .listing-card,
  .listingCard,
  .offer-card,
  .offerCard {
    width: 100% !important;
    max-width: 100% !important;
    box-sizing: border-box !important;
    overflow: hidden !important;
    border-radius: var(--sellcore-phone-card-radius) !important;
  }

  /* Header should feel fitted, not oversized */
  header,
  .header,
  .appHeader,
  .app-header,
  .hero,
  .heroPanel,
  .hero-panel,
  .topPanel,
  .top-panel,
  .sellcoreHero,
  .sellcore-hero,
  .shellHeader,
  .shell-header {
    padding: 10px 10px 9px !important;
    margin-bottom: 8px !important;
    min-height: unset !important;
  }

  /* Control oversized text pressure inside framed header */
  header h1,
  .header h1,
  .appHeader h1,
  .app-header h1,
  .hero h1,
  .heroPanel h1,
  .hero-panel h1,
  .topPanel h1,
  .top-panel h1,
  .sellcoreHero h1,
  .sellcore-hero h1,
  .shellHeader h1,
  .shell-header h1 {
    font-size: clamp(0.76rem, 3.8vw, 0.98rem) !important;
    line-height: 1.08 !important;
    letter-spacing: 0.05em !important;
  }

  header p,
  .header p,
  .appHeader p,
  .app-header p,
  .hero p,
  .heroPanel p,
  .hero-panel p,
  .topPanel p,
  .top-panel p,
  .sellcoreHero p,
  .sellcore-hero p,
  .shellHeader p,
  .shell-header p {
    font-size: clamp(0.52rem, 3vw, 0.66rem) !important;
    line-height: 1.16 !important;
  }

  /* Inputs and cards obey phone frame */
  input,
  select,
  textarea,
  button {
    max-width: 100% !important;
    box-sizing: border-box !important;
  }

  img,
  video,
  canvas {
    max-width: 100% !important;
    height: auto !important;
    object-fit: cover;
  }

  /* Feed/profile media should not blow out the layout */
  .listingImage,
  .listing-image,
  .feedImage,
  .feed-image,
  .profileImage,
  .profile-image,
  .profileBanner,
  .profile-banner,
  .avatar,
  .banner {
    max-width: 100% !important;
    overflow: hidden !important;
  }

  /* Bottom nav locked to phone specs */
  .bottomNav,
  .bottom-nav,
  .mobileNav,
  .mobile-nav,
  .utilityBar,
  .utility-bar,
  .utilitiesBar,
  .utilities-bar,
  .footerNav,
  .footer-nav,
  nav[class*="bottom"],
  div[class*="bottomNav"],
  div[class*="utilityBar"],
  div[class*="utilitiesBar"] {
    position: fixed !important;
    left: 50% !important;
    bottom: calc(6px + env(safe-area-inset-bottom)) !important;
    transform: translateX(-50%) !important;
    width: var(--sellcore-phone-bottom-nav-width) !important;
    max-width: var(--sellcore-phone-bottom-nav-max) !important;
    min-height: var(--sellcore-phone-bottom-nav-height) !important;
    padding: 5px !important;
    gap: 3px !important;
    display: grid !important;
    grid-template-columns: repeat(auto-fit, minmax(40px, 1fr)) !important;
    align-items: center !important;
    box-sizing: border-box !important;
    border-radius: 18px !important;
    overflow: hidden !important;
    z-index: 100 !important;
  }

  .bottomNav button,
  .bottom-nav button,
  .mobileNav button,
  .mobile-nav button,
  .utilityBar button,
  .utility-bar button,
  .utilitiesBar button,
  .utilities-bar button,
  .footerNav button,
  .footer-nav button,
  nav[class*="bottom"] button,
  div[class*="bottomNav"] button,
  div[class*="utilityBar"] button,
  div[class*="utilitiesBar"] button {
    width: 100% !important;
    min-width: 0 !important;
    max-width: 100% !important;
    min-height: 42px !important;
    padding: 4px 2px !important;
    border-radius: 12px !important;
    font-size: 0.5rem !important;
    line-height: 1 !important;
    white-space: nowrap !important;
    overflow: hidden !important;
    text-overflow: ellipsis !important;
  }

  .bottomNav span,
  .bottom-nav span,
  .mobileNav span,
  .mobile-nav span,
  .utilityBar span,
  .utility-bar span,
  .utilitiesBar span,
  .utilities-bar span,
  .footerNav span,
  .footer-nav span,
  .navLabel,
  .nav-label,
  .utilityLabel,
  .utility-label,
  .tabLabel,
  .tab-label,
  .buttonLabel,
  .button-label {
    max-width: 100% !important;
    font-size: 0.48rem !important;
    line-height: 1 !important;
    white-space: nowrap !important;
    overflow: hidden !important;
    text-overflow: ellipsis !important;
  }
}

/* Smaller phones get tighter framing */
@media (max-width: 390px) {
  :root {
    --sellcore-phone-edge-gap: 6px;
    --sellcore-phone-bottom-nav-width: calc(100% - 10px);
    --sellcore-phone-bottom-nav-max: 366px;
    --sellcore-phone-bottom-nav-height: 54px;
  }

  .appShell,
  .app-shell,
  .sellcore-shell,
  .sellcoreShell,
  .core-shell,
  .coreShell,
  .marketplace-shell,
  .marketplaceShell,
  main {
    padding-left: 6px !important;
    padding-right: 6px !important;
  }

  section,
  article,
  .card,
  .core-card,
  .coreCard,
  .panel,
  .market-panel,
  .marketPanel,
  .profile-panel,
  .profilePanel,
  .utility-panel,
  .utilityPanel {
    padding: 8px !important;
  }
}

/* Desktop preview of mobile stays clean instead of stretching weirdly */
@media (min-width: 761px) {
  #root {
    max-width: 760px !important;
    margin-left: auto !important;
    margin-right: auto !important;
  }
}
